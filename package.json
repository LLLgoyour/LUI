{
  "name": "lui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "description": "Vue-first UI system and Astro-facing design layer for LLLgoyour sites.",
  "scripts": {
    "build": "pnpm -r --if-present build && pnpm docs:build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "pnpm --filter @lllgoyour/lui-vue test",
    "typecheck": "pnpm --filter @lllgoyour/lui-vue typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitepress": "^1.6.3"
  },
  "author": "LLLgoyour",
  "license": "MIT"
}
