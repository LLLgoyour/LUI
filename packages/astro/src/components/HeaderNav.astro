---
export interface NavItem {
  href: string;
  label: string;
  external?: boolean;
  target?: string;
  rel?: string;
}

interface Props {
  brandLabel: string;
  brandHref?: string;
  currentPath?: string;
  navItems: NavItem[];
  searchHref?: string;
  class?: string;
}

const {
  brandLabel,
  brandHref = "/",
  currentPath = "/",
  navItems = [],
  searchHref,
  class: className,
} = Astro.props;

const normalizePath = (value: string) => {
  const normalized = value.replace(/\/+$/, "");
  return normalized || "/";
};

const current = normalizePath(currentPath);
const topLevel = "/" + (current.split("/").filter(Boolean)[0] || "");
const homePath = normalizePath(brandHref);

const isActive = (href: string, external?: boolean) => {
  if (external) {
    return false;
  }

  const normalized = normalizePath(href);
  if (normalized === homePath) {
    return current === normalized || current === topLevel;
  }

  return current === normalized || current.startsWith(`${normalized}/`);
};
---

<header class:list={["lui-header", className]}>
  <nav class="lui-header__nav" aria-label="Primary">
    <h2 class="lui-header__brand">
      <a href={brandHref}>{brandLabel}</a>
    </h2>
    <div class="lui-header__links">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            target={item.target}
            rel={item.rel}
            class:list={[
              "lui-header__link",
              { "is-active": isActive(item.href, item.external) },
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>
    <div class="lui-header__controls" aria-label="Site controls">
      {
        searchHref && (
          <a
            href={searchHref}
            class="lui-icon-link"
            title="Search posts"
            aria-label="Search posts"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" aria-hidden="true">
              <path
                d="M416 208c0 45.9-14.9 88.3-40 122.7l95.6 95.6c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.1-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0S416 93.1 416 208zm-208 144a144 144 0 1 0 0-288a144 144 0 1 0 0 288z"
              ></path>
            </svg>
          </a>
        )
      }
      <slot name="controls" />
    </div>
  </nav>
</header>
